{#
/**
 * @file
 * Theme override for page nodes.
 */
#}
<article{{ attributes.addClass('theater-page-node') }}>
  {{ title_prefix }}
  {% if not page and label %}
    <h2{{ title_attributes.addClass('theater-page-node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% elseif label %}
    <h1{{ title_attributes.addClass('theater-page-node__title') }}>{{ label }}</h1>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('theater-page-node__content') }}>
    {{ content }}
  </div>
</article>
