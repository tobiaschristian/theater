<?php

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function theater_membership_install(): void {
  foreach ([
    'mitglied' => 'Mitglied',
    'foerdermitglied' => 'Foerdermitglied',
  ] as $role_id => $label) {
    if (!Role::load($role_id)) {
      Role::create([
        'id' => $role_id,
        'label' => $label,
      ])->save();
    }
  }
}
