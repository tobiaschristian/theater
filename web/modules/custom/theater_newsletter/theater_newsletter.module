<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\theater_newsletter\Entity\NewsletterSubscriberInterface;
use Drupal\user\UserInterface;

/**
 * Wie lange eine unbestätigte Anmeldung aufbewahrt wird, bevor Cron sie
 * löscht (Spam-/Missbrauchsschutz).
 */
const THEATER_NEWSLETTER_PENDING_MAX_AGE = 7 * 24 * 60 * 60;

/**
 * Implements hook_theme().
 *
 * Ein gemeinsames HTML-Template für alle Newsletter-Mails (siehe
 * TokenManager::sendConfirmationMail()).
 */
function theater_newsletter_theme(): array {
  return [
    'theater_newsletter_mail' => [
      'variables' => [
        'heading' => NULL,
        'intro' => NULL,
        'button_url' => NULL,
        'button_label' => NULL,
        'outro' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Löscht unbestätigte Newsletter-Anmeldungen, die länger als
 * THEATER_NEWSLETTER_PENDING_MAX_AGE offen sind (Spamschutz: verhindert,
 * dass nie bestätigte Anmeldungen dauerhaft in der Tabelle bleiben).
 */
function theater_newsletter_cron(): void {
  $deleted = \Drupal::service('theater_newsletter.token_manager')->garbageCollectStalePending(THEATER_NEWSLETTER_PENDING_MAX_AGE);

  if ($deleted > 0) {
    \Drupal::logger('theater_newsletter')->info('@count unbestätigte Newsletter-Anmeldungen (älter als 7 Tage) gelöscht.', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Implements hook_user_login().
 *
 * Verknüpft einen bestehenden, noch nicht zugeordneten Abonnenten-
 * Datensatz automatisch mit dem Konto, falls die E-Mail-Adresse passt.
 */
function theater_newsletter_user_login(UserInterface $account): void {
  \Drupal::service('theater_newsletter.token_manager')->syncAccountLink($account);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * Fügt eine Checkbox zur Newsletter-Verwaltung in die Kontoeinstellungen
 * ein (Muster: theater_membership_form_user_form_alter()). Eingeloggte
 * Nutzer verwalten ihr Abo hierüber ohne Token, da die Session selbst der
 * Identitätsnachweis ist.
 */
function theater_newsletter_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $account = $form_object->getEntity();
  if (!$account instanceof UserInterface || $account->isAnonymous()) {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ((int) $current_user->id() !== (int) $account->id() && !$current_user->hasPermission('administer users')) {
    return;
  }

  $token_manager = \Drupal::service('theater_newsletter.token_manager');
  $subscriber = $token_manager->getSubscriberForAccount($account);

  $form['theater_newsletter'] = [
    '#type' => 'container',
    '#title' => t('Newsletter'),
    '#weight' => 5,
  ];

  $form['theater_newsletter']['theater_newsletter_subscribed'] = [
    '#type' => 'checkbox',
    '#title' => t('Ich möchte den Newsletter erhalten'),
    '#default_value' => $subscriber instanceof NewsletterSubscriberInterface && $subscriber->isConfirmed(),
  ];

  $form['actions']['submit']['#submit'][] = 'theater_newsletter_user_form_submit';
}

/**
 * Persistiert die Newsletter-Checkbox aus den Kontoeinstellungen.
 */
function theater_newsletter_user_form_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $account = $form_object->getEntity();
  if (!$account instanceof UserInterface || !$account->id()) {
    return;
  }

  $subscribed = (bool) $form_state->getValue('theater_newsletter_subscribed');
  $ip = \Drupal::request()->getClientIp() ?? '0.0.0.0';

  \Drupal::service('theater_newsletter.token_manager')->setSubscribedForAccount($account, $subscribed, $ip);
}
