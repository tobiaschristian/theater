<?php

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function theater_tickets_schema(): array {
  $schema['theater_seat_hold'] = [
    'description' => 'Temporäre Sitzplatzreservierungen (5 Minuten) vor dem endgültigen Kauf.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primärschlüssel.',
      ],
      'seat_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Entity-ID des referenzierten theater_platz.',
      ],
      'performance_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Node-ID der referenzierten Vorstellung.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'User-ID, der den Platz hält.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix-Zeitstempel der Reservierung.',
      ],
      'expires' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix-Zeitstempel, ab dem die Reservierung abläuft.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'seat_performance' => ['seat_id', 'performance_id'],
    ],
    'indexes' => [
      'uid' => ['uid'],
      'performance_id' => ['performance_id'],
      'expires' => ['expires'],
    ],
  ];

  return $schema;
}

/**
 * Legt den Saal "Theatersaal" mit den 114 tatsächlich verkauften Plätzen an.
 *
 * Der reale Sitzplan hat unregelmäßige Reihenlängen und zusätzliche
 * Sonderkarten-Plätze (13A, 26A, 27A, 41A, 114–120), die nach Absprache
 * gar nicht als buchbare Plätze angelegt werden.
 */
function theater_tickets_update_10001(): string {
  $saalStorage = \Drupal::entityTypeManager()->getStorage('saal');
  $saal = $saalStorage->load('theatersaal');

  if (!$saal) {
    $saal = \Drupal\theater_tickets\Entity\Saal::create([
      'id' => 'theatersaal',
      'label' => 'Theatersaal',
      'description' => 'Haupt-Theatersaal, 114 buchbare Plätze (Sonderkarten und Reihe 8 links nicht enthalten).',
    ]);
    $saal->save();
  }

  // Reihe => [erste Platznummer, letzte Platznummer]. Reihen 1–7 sind
  // durchgehend nummeriert, Sonderkarten-Plätze liegen außerhalb dieser
  // Bereiche und werden dadurch automatisch ausgelassen.
  $ranges = [
    '1' => [1, 12],
    '2' => [13, 26],
    '3' => [27, 41],
    '4' => [42, 58],
    '5' => [59, 76],
    '6' => [77, 94],
    '7' => [95, 113],
  ];

  $platzStorage = \Drupal::entityTypeManager()->getStorage('theater_platz');
  $created = 0;

  foreach ($ranges as $rowLabel => [$from, $to]) {
    $rowLabel = (string) $rowLabel;
    for ($seatNumber = $from; $seatNumber <= $to; $seatNumber++) {
      if (theater_tickets_seat_exists($platzStorage, $saal->id(), $rowLabel, $seatNumber)) {
        continue;
      }
      $platzStorage->create([
        'saal' => $saal->id(),
        'row_label' => $rowLabel,
        'seat_number' => $seatNumber,
      ])->save();
      $created++;
    }
  }

  return "Saal 'Theatersaal': {$created} neue Plätze angelegt.";
}

/**
 * Blendet Saison/Saal aus der Node-Anzeige aus, formatiert Termin/Preis.
 *
 * Saison und Saal sind interne Verwaltungsdaten ohne Mehrwert für
 * Besucher; die Buchung läuft ohnehin über den Sitzplan-Link (siehe
 * theater_tickets_node_view()), nicht über die Node-Felder selbst.
 */
function theater_tickets_update_10002(): string {
  $display = \Drupal::service('entity_display.repository')->getViewDisplay('node', 'vorstellung', 'default');

  $display->removeComponent('field_saison');
  $display->removeComponent('field_saal');

  $display->setComponent('field_datum', [
    'label' => 'above',
    'type' => 'datetime_default',
    'settings' => [
      'timezone_override' => '',
      'format_type' => 'long',
    ],
    'weight' => 0,
  ]);

  $display->setComponent('field_preis', [
    'label' => 'above',
    'type' => 'number_decimal',
    'settings' => [
      'thousand_separator' => '.',
      'decimal_separator' => ',',
      'scale' => 2,
      'prefix_suffix' => TRUE,
    ],
    'weight' => 1,
  ]);

  $display->save();

  return 'Anzeige für Vorstellung aktualisiert (Saison/Saal ausgeblendet, Termin/Preis formatiert).';
}

/**
 * Entfernt Platz 120 (Gang-Platz) wieder — Client hat entschieden, dass
 * dieser Platz gar nicht angeboten werden soll.
 */
function theater_tickets_update_10003(): string {
  $platzStorage = \Drupal::entityTypeManager()->getStorage('theater_platz');
  $ids = $platzStorage->getQuery()
    ->condition('saal', 'theatersaal')
    ->condition('row_label', '8')
    ->condition('seat_number', 120)
    ->accessCheck(FALSE)
    ->execute();

  if (!$ids) {
    return "Platz 120 war nicht vorhanden, nichts zu tun.";
  }

  $platzStorage->delete($platzStorage->loadMultiple($ids));

  return 'Platz 120 (Gang-Platz) entfernt.';
}

/**
 * Prüft, ob ein Platz mit dieser Reihe/Nummer im Saal bereits existiert.
 */
function theater_tickets_seat_exists($platzStorage, string $saalId, string $rowLabel, int $seatNumber): bool {
  $count = $platzStorage->getQuery()
    ->condition('saal', $saalId)
    ->condition('row_label', $rowLabel)
    ->condition('seat_number', $seatNumber)
    ->accessCheck(FALSE)
    ->count()
    ->execute();

  return $count > 0;
}
