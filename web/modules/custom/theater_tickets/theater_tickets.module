<?php

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_view() for node.
 *
 * Ergänzt die Vorstellung-Seite um einen deutlichen Link zum Sitzplan,
 * statt die Buchung über die Node-Seite selbst abzuwickeln.
 */
function theater_tickets_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($node->bundle() !== 'vorstellung' || $view_mode !== 'full') {
    return;
  }

  $build['theater_tickets_seat_picker_link'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['theater-tickets-cta']],
    '#weight' => -10,
    'link' => Link::fromTextAndUrl(t('Jetzt Plätze wählen'), Url::fromRoute('theater_tickets.seat_picker', ['node' => $node->id()]))
      ->toRenderable() + ['#attributes' => ['class' => ['button']]],
  ];
}

/**
 * Implements hook_cron().
 *
 * Räumt abgelaufene Sitzplatzreservierungen auf. Die Gültigkeit einer
 * Reservierung wird davon unabhängig immer live gegen die aktuelle Zeit
 * geprüft (siehe SeatHoldManager::isHeld()) – dieser Cron-Lauf hält die
 * Tabelle nur klein.
 */
function theater_tickets_cron(): void {
  $deleted = \Drupal::service('theater_tickets.seat_hold_manager')->garbageCollectExpiredHolds();

  if ($deleted > 0) {
    \Drupal::logger('theater_tickets')->info('@count abgelaufene Sitzplatzreservierungen aufgeräumt.', [
      '@count' => $deleted,
    ]);
  }
}
