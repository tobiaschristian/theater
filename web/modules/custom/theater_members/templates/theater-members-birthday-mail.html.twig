{#
/**
 * @file
 * HTML-Template für die Geburtstags-Reminder-Mail. Angelehnt an
 * theater_newsletter/templates/theater-newsletter-mail.html.twig für ein
 * einheitliches Erscheinungsbild aller Vereins-Mails.
 *
 * Variablen:
 * - heading: Überschrift.
 * - intro: Einleitungstext.
 * - members: Liste von {name, date, age}.
 * - outro: Abschließender Hinweistext.
 *
 * @ingroup themeable
 */
#}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; font-family: Arial, Helvetica, sans-serif; color: #1a1a1a;">
  <tr>
    <td style="padding: 24px 0 8px 0; font-size: 20px; font-weight: bold;">
      Theater- &amp; Kulturverein Zapfendorf e.V.
    </td>
  </tr>
  <tr>
    <td style="padding: 8px 0 16px 0; font-size: 18px; font-weight: bold;">
      {{ heading }}
    </td>
  </tr>
  <tr>
    <td style="padding: 0 0 16px 0; font-size: 15px; line-height: 1.5;">
      {{ intro }}
    </td>
  </tr>
  <tr>
    <td style="padding: 0 0 24px 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 15px;">
        {% for member in members %}
          <tr>
            <td style="padding: 6px 0; border-bottom: 1px solid #e0e0e0;">
              <strong>{{ member.name }}</strong> — {{ member.date }} (wird {{ member.age }})
            </td>
          </tr>
        {% endfor %}
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding: 16px 0 0 0; font-size: 13px; line-height: 1.5; color: #666666; border-top: 1px solid #e0e0e0;">
      {{ outro }}
    </td>
  </tr>
</table>
